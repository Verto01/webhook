NODE_ENV=development
PORT=3000
HOST=127.0.0.1
LOG_LEVEL=info

POSTGRES_USER=webhook
POSTGRES_PASSWORD=replace_with_a_secure_password
POSTGRES_DB=webhook_dev
POSTGRES_PORT=5432

DATABASE_URL=postgresql://webhook:replace_with_a_secure_password@127.0.0.1:5432/webhook_dev
