{
  "name": "webhook-dispatcher",
  "version": "1.0.0",
  "description": "A fault-tolerant webhook delivery system",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=24.13.0 <25"
  },
  "packageManager": "npm@11.6.2",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Verto01/webhook.git"
  },
  "keywords": [
    "webhooks",
    "nodejs",
    "typescript",
    "backend"
  ],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/Verto01/webhook/issues"
  },
  "homepage": "https://github.com/Verto01/webhook#readme",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "dotenv": "^18.0.10",
    "eslint": "^10.15.0",
    "node-pg-migrate": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "pg": "^8.23.1"
  }
}
